+//! HarnessReducer Linux process cleanup, only on timeout/cancellation.
+use std::collections::HashSet;
+use std::fs;
+use std::io;
+use std::process::Child;
+use std::time::Duration;
+use wait_timeout::ChildExt;
+
+unsafe extern "C" {
+    fn kill(pid: i32, signal: i32) -> i32;
+    fn getpgrp() -> i32;
+}
+
+fn groups(root: u32) -> HashSet<i32> {
+    let mut result = HashSet::from([root as i32]);
+    let mut seen = HashSet::new();
+    let mut pending = vec![root];
+    while let Some(pid) = pending.pop() {
+        if !seen.insert(pid) { continue; }
+        if let Ok(stat) = fs::read_to_string(format!("/proc/{pid}/stat")) {
+            if let Some((_, fields)) = stat.rsplit_once(") ") {
+                if let Some(group) = fields.split_whitespace().nth(2).and_then(|s| s.parse::<i32>().ok()) {
+                    result.insert(group);
+                }
+            }
+        }
+        if let Ok(tasks) = fs::read_dir(format!("/proc/{pid}/task")) {
+            for task in tasks.flatten() {
+                if let Ok(children) = fs::read_to_string(task.path().join("children")) {
+                    pending.extend(children.split_whitespace().filter_map(|s| s.parse::<u32>().ok()));
+                }
+            }
+        }
+    }
+    let own_group = unsafe { getpgrp() };
+    result.retain(|group| *group > 0 && *group != own_group);
+    result
+}
+
+pub(super) fn terminate(child: &mut Child) -> io::Result<()> {
+    // Snapshot nested Python executor groups before terminating their owners.
+    // This traversal is never performed for ordinary completed checks.
+    let groups = groups(child.id());
+    for group in &groups { unsafe { kill(-*group, 15); } }
+    // TERM allows Python's profile/file cleanup to finish. Never skip KILL
+    // merely because the immediate checker has already exited.
+    let waited = child.wait_timeout(Duration::from_secs(1));
+    for group in &groups { unsafe { kill(-*group, 9); } }
+    // Always reap, including when waiting/signaling races with child exit.
+    let reaped = child.wait();
+    waited?;
+    reaped.map(|_| ())
+}
